+	/*
+	 * FG2000 AW9523 is connected to BLSP1 QUP5 I2C:
+	 * SDA/SCL = GPIO21/GPIO22, 7-bit address = 0x5b.
+	 */
+	i2c1: i2c@78b9000 {
+		compatible = "qcom,qup-i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x78b9000 0x600>;
+		clock-frequency = <400000>;
+		status = "okay";
+
+		i2c_gpio {
+			scl {
+				gpio = <21>;
+				func = <3>;
+				pull = <GPIO_PULL_UP>;
+				drvstr = <GPIO_8MA>;
+				oe = <GPIO_OE_ENABLE>;
+			};
+
+			sda {
+				gpio = <22>;
+				func = <3>;
+				pull = <GPIO_PULL_UP>;
+				drvstr = <GPIO_8MA>;
+				oe = <GPIO_OE_ENABLE>;
+			};
+		};
+
+		aw9523@5b {
+			compatible = "awinic,aw9523-pinctrl";
+			reg = <0x5b>;
+		};
+	};
+
