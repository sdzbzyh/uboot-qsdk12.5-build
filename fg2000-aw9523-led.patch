+	 * These labels are used by the existing U-Boot status/failsafe code.
+	 * They live outside /leds so SoC GPIO initialization won't treat
+	 * expander GPIO numbers as IPQ8074 TLMM GPIO numbers.
+	 */
+	aw9523-leds {
+		led-blue {
+			label = "blink_led";
+			aw9523-gpio = <2>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+
+		led-red {
+			label = "power_led";
+			aw9523-gpio = <5>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+
+		led-green {
+			label = "system_led";
+			aw9523-gpio = <3>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+	};
 
