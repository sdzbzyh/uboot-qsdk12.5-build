+static void led_control_node(int node, led_op_t op)
+{
+	unsigned int gpio, aw9523_gpio, active_level, value;
+	int on;
+
+	gpio = fdtdec_get_uint(gd->fdt_blob, node, "gpio", GPIO_NOT_FOUND);
+	aw9523_gpio = fdtdec_get_uint(gd->fdt_blob, node, "aw9523-gpio",
+				       GPIO_NOT_FOUND);
+	active_level = fdtdec_get_uint(gd->fdt_blob, node, "active_level",
+				       GPIO_ACTIVE_HIGH);
+
+	if (aw9523_gpio != GPIO_NOT_FOUND) {
+		if (op == LED_OP_TOGGLE)
+			on = !aw9523_gpio_get(aw9523_gpio);
+		else
+			on = (op == LED_OP_ON);
+
+		if (active_level == GPIO_ACTIVE_LOW)
+			on = !on;
+		aw9523_gpio_set(aw9523_gpio, on);
+		return;
+	}
+
+	if (gpio != GPIO_NOT_FOUND &&
+	    !led_get_out_value(op, gpio, active_level, &value))
+		gpio_set_value(gpio, value);
+}
