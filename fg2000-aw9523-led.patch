+/*
+ * AW9523 register map. The FG2000 status LEDs are on port 0:
+ * blue=GPIO2, green=GPIO3, red=GPIO5.
+ */
+#define AW9523_I2C_BUS		1
+#define AW9523_I2C_ADDR		0x5b
+#define AW9523_REG_INPUT0	0x00
+#define AW9523_REG_OUTPUT0	0x02
+#define AW9523_REG_CONFIG0	0x04
+#define AW9523_REG_INT_EN0	0x06
+#define AW9523_REG_CHIP_ID	0x10
+#define AW9523_REG_GCR		0x11
+#define AW9523_REG_PORT_MODE0	0x12
+#define AW9523_REG_SOFT_RESET	0x7f
+#define AW9523_CHIP_ID		0x23
+#define AW9523_GCR_PUSH_PULL	BIT(4)
+#define AW9523_LED_MASK		(BIT(2) | BIT(3) | BIT(5))
+
 DECLARE_GLOBAL_DATA_PTR;
 
+static struct udevice *aw9523_dev;
+static int aw9523_initialized;
+static u8 aw9523_port0_state;
+
+static int aw9523_write_reg(u8 reg, u8 value)
+{
+	return dm_i2c_reg_write(aw9523_dev, reg, value);
+}
+
+static int aw9523_init(void)
+{
+	int ret;
+	int chip_id;
+
+	if (aw9523_initialized)
+		return 0;
+
+	ret = i2c_get_chip_for_busnum(AW9523_I2C_BUS, AW9523_I2C_ADDR,
+				      1, &aw9523_dev);
+	if (ret)
+		return ret;
+
+	/* A soft reset is harmless if the chip is already at its defaults. */
+	ret = aw9523_write_reg(AW9523_REG_SOFT_RESET, 0);
+	if (ret)
+		return ret;
+
+	mdelay(1);
+	chip_id = dm_i2c_reg_read(aw9523_dev, AW9523_REG_CHIP_ID);
+	if (chip_id < 0)
+		return chip_id;
+	if (chip_id != AW9523_CHIP_ID)
+		return -ENODEV;
+
+	/*
+	 * Put the ports in a safe state before enabling LED outputs:
+	 * all inputs, output latches low, then GPIO/push-pull mode.
+	 */
+	ret = aw9523_write_reg(AW9523_REG_CONFIG0, 0xff);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_CONFIG0 + 1, 0xff);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_OUTPUT0, 0x00);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_OUTPUT0 + 1, 0x00);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_GCR, AW9523_GCR_PUSH_PULL);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_PORT_MODE0, 0xff);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_PORT_MODE0 + 1, 0xff);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_INT_EN0, 0xff);
+	if (ret)
+		return ret;
+	ret = aw9523_write_reg(AW9523_REG_INT_EN0 + 1, 0xff);
+	if (ret)
+		return ret;
+
+	/* AW9523 config bit 1=input, 0=output. Keep unused pins as inputs. */
+	ret = aw9523_write_reg(AW9523_REG_CONFIG0,
+			       (u8)~AW9523_LED_MASK);
+	if (ret)
+		return ret;
+
+	aw9523_port0_state = 0;
+	aw9523_initialized = 1;
+	return 0;
+}
+
+static int aw9523_gpio_set(unsigned int pin, int on)
+{
+	u8 state;
+	int ret;
+
+	/* FG2000's three status LEDs are all connected to AW9523 port 0. */
+	if (pin >= 8)
+		return -EINVAL;
+
+	ret = aw9523_init();
+	if (ret)
+		return ret;
+
+	if (on)
+		state = aw9523_port0_state | BIT(pin);
+	else
+		state = aw9523_port0_state & ~BIT(pin);
+
+	ret = aw9523_write_reg(AW9523_REG_OUTPUT0, state);
+	if (!ret)
+		aw9523_port0_state = state;
+
+	return ret;
+}
+
+static int aw9523_gpio_get(unsigned int pin)
+{
+	int ret;
+
+	if (pin >= 8)
+		return 0;
+
+	ret = aw9523_init();
+	if (ret)
+		return 0;
+
+	return !!(aw9523_port0_state & BIT(pin));
+}
